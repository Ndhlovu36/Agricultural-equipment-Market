<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>AGRI Pi MARKET • 35 MACHINES</title>
<script src="https://sdk.minepi.com/pi-sdk.js"></script>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:Arial;background:#0a1931;color:#fff}
.header{background:#fff;padding:10px 12px;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:100}
.logo{font-weight:900;color:#0052cc;line-height:1.1;font-size:14px}.logo span{color:#ffcc00}
.tabs{display:flex;gap:4px;background:#eee;padding:3px;border-radius:20px}
.tabs button{padding:6px 10px;border-radius:15px;border:none;font-size:9px;font-weight:900;cursor:pointer}
.tabs button.active{background:#0052cc;color:#fff}.tabs button.test-active{background:#ff4444;color:#fff}
.btn{padding:8px 12px;border-radius:20px;border:none;font-weight:900;font-size:10px;background:#6a1bbf;color:#fff;cursor:pointer}
.mode-banner{text-align:center;padding:6px;font-size:10px;font-weight:900;color:#fff}
.mode-main{background:#6a1bbf}.mode-test{background:#ff4444}
.hero{background:linear-gradient(180deg,#0d2550,#06102a);padding:20px 12px;text-align:center}
.hero h1{color:#ffcc00;font-size:28px;line-height:1.1;font-weight:900}.hero h1 span{color:#fff}
.hero p{font-size:11px;margin-top:8px;color:#cbd5e1}
.filters{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;margin-top:12px}
.filters button{padding:7px 12px;border-radius:20px;border:none;font-size:10px;font-weight:900;background:#fff;color:#0a1931;cursor:pointer}
.filters button.active{background:#0052cc;color:#fff}
.section{max-width:1200px;margin:auto;padding:12px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
@media(min-width:900px){.grid{grid-template-columns:1fr 1fr 1fr 1fr}}
.card{background:#fff;border-radius:12px;overflow:hidden;color:#0a1931;position:relative;box-shadow:0 4px 12px rgba(0,0,0,.2)}
.card img{width:100%;height:130px;object-fit:cover;background:#ddd}
.badge{position:absolute;top:6px;left:6px;padding:3px 7px;border-radius:10px;font-size:8px;font-weight:900;color:#fff}
.b-plough{background:#0052cc}.b-harvest{background:#ff8800}.b-spray{background:#00aa55}.b-fert{background:#aa5500}.b-planter{background:#6a1bbf}
.card-body{padding:7px}.card-body h3{font-size:10px;line-height:1.2}.card-body p{font-size:8px;color:#666}.price{font-weight:900;color:#0052cc;font-size:12px;margin-top:4px}
.cart{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#0a1931;border:2px solid #ffcc00;color:#fff;padding:10px 18px;border-radius:30px;font-size:12px;font-weight:900;z-index:200;box-shadow:0 6px 20px rgba(0,0,0,.4);cursor:pointer}
.pi-status{font-size:10px;background:#f0f0f0;color:#000;padding:8px;border-radius:8px;margin-top:8px;word-break:break-all}
#errorBox{background:#ff4444;color:#fff;padding:8px;font-size:11px;display:none;text-align:center}
</style>
</head>
<body>

<div id="errorBox"></div>
<div id="modeBanner" class="mode-banner mode-main">MODE: MAINNET Pi - Real Payments - approve-payment.js Fixed</div>

<div class="header">
<div class="logo">AGRI Pi MARKET • 35<br><span>MACHINES</span></div>
<div style="display:flex;gap:6px;align-items:center">
<div class="tabs">
<button id="btnMain" class="active" onclick="setMode(false)">MAINNET Pi</button>
<button id="btnTest" onclick="setMode(true)">TESTNET Pi</button>
</div>
<button id="loginBtn" class="btn" onclick="piLogin()">π Login</button>
</div>
</div>

<div class="hero">
<h1>35 HUGE<br>MACHINERY<br><span>ALL PRICES IN Pi ONLY</span></h1>
<p>10 Ploughing • 10 Harvesting • 5 Sprayer • 5 Fertilizer • 5 Planter • Branded John Deere, IH, Claas, Kubota, Massey, New Holland</p>
<div class="filters">
<button id="f-all" class="active" onclick="filterCat('all')">ALL 35</button>
<button id="f-plough" onclick="filterCat('plough')">PLOUGHING (10)</button>
<button id="f-harvest" onclick="filterCat('harvest')">HARVESTING (10)</button>
<button id="f-sprayer" onclick="filterCat('sprayer')">SPRAYER (5)</button>
<button id="f-fert" onclick="filterCat('fert')">FERTILIZER (5)</button>
<button id="f-planter" onclick="filterCat('planter')">PLANTER (5)</button>
</div>
<div id="piStatus" class="pi-status" style="max-width:400px;margin:10px auto 0">1. Login in Pi Browser 2. Tap machine 3. Pay with Pi • Fixed API</div>
</div>

<div class="section">
<div id="grid" class="grid"></div>
</div>

<div id="cart" class="cart" onclick="checkout()">🛒 Cart: 0 • 0 π • Pay with Pi</div>

<script>
window.onerror=function(m,s,l){ document.getElementById('errorBox').style.display='block'; document.getElementById('errorBox').innerText='JS Error: '+m+' line:'+l; };

let isTestnet=false, piUser=null, currentCat='all', cart=[], cartTotal=0;

const machines=[
{id:1,cat:'plough',file:'AGRI-01-PLOUGH-JohnDeere-8R-410-Disc.jpg',brand:'John Deere',name:'8R 410 + 2140 Disc Plow',desc:'10 Discs Heavy Duty',pi:28.5},
{id:2,cat:'plough',file:'AGRI-02-PLOUGH-CaseIH-Steiger-620-Ecolo.jpg',brand:'Case IH',name:'Steiger 620 + Ecolo-Tiger Plough',desc:'11 Shanks Ripper',pi:32},
{id:3,cat:'plough',file:'AGRI-03-PLOUGH-JohnDeere-9R-640-Ripper.jpg',brand:'John Deere',name:'9R 640 + 2720 Disc Ripper',desc:'13 Shanks',pi:35},
{id:4,cat:'plough',file:'AGRI-04-PLOUGH-CaseIH-Quadtrac-715.jpg',brand:'Case IH',name:'Quadtrac 715 + RMX 370',desc:'Quadtrac Heavy Plough',pi:38},
{id:5,cat:'plough',file:'AGRI-05-PLOUGH-NewHolland-T9-700.jpg',brand:'New Holland',name:'T9.700 + Ecolo-Tiger 875',desc:'Big Tractor Plough',pi:30},
{id:6,cat:'plough',file:'AGRI-06-PLOUGH-Claas-Xerion-5000.jpg',brand:'Claas',name:'Xerion 5000 + Lemken Diamant',desc:'5 Furrow Reversible',pi:29},
{id:7,cat:'plough',file:'AGRI-07-PLOUGH-Kubota-M8-201.jpg',brand:'Kubota',name:'M8-201 + Kverneland Plough',desc:'5 Furrow',pi:18},
{id:8,cat:'plough',file:'AGRI-08-PLOUGH-Massey-8737.jpg',brand:'Massey Ferguson',name:'8737 + Gregoire Besson',desc:'6 Furrow',pi:22},
{id:9,cat:'plough',file:'AGRI-09-PLOUGH-JohnDeere-8RX-410.jpg',brand:'John Deere',name:'8RX 410 + Kuhn Optimer',desc:'Track Tractor Disc',pi:33},
{id:10,cat:'plough',file:'AGRI-10-PLOUGH-CaseIH-Magnum-400.jpg',brand:'Case IH',name:'Magnum 400 + Horsch Tiger',desc:'Heavy Duty DT',pi:27},
{id:11,cat:'harvest',file:'AGRI-11-HARVEST-JohnDeere-S790.jpg',brand:'John Deere',name:'S790 Combine Harvester',desc:'Corn & Wheat',pi:85},
{id:12,cat:'harvest',file:'AGRI-12-HARVEST-CaseIH-8250.jpg',brand:'Case IH',name:'Axial-Flow 8250 Combine',desc:'High Capacity',pi:82},
{id:13,cat:'harvest',file:'AGRI-13-HARVEST-Claas-Lexion-8900.jpg',brand:'Claas',name:'Lexion 8900 Combine',desc:'Class 10 Biggest',pi:95},
{id:14,cat:'harvest',file:'AGRI-14-HARVEST-NewHolland-CR10-90.jpg',brand:'New Holland',name:'CR10.90 Combine',desc:'Twin Rotor',pi:88},
{id:15,cat:'harvest',file:'AGRI-15-HARVEST-JohnDeere-X9-1100.jpg',brand:'John Deere',name:'X9 1100 Combine',desc:'Flagship',pi:92},
{id:16,cat:'harvest',file:'AGRI-16-HARVEST-Massey-Ideal-9T.jpg',brand:'Massey Ferguson',name:'Ideal 9T Combine',desc:'Ideal Series',pi:78},
{id:17,cat:'harvest',file:'AGRI-17-HARVEST-Kubota-DC-105X.jpg',brand:'Kubota',name:'DC-105X Combine',desc:'Rice Harvester',pi:25},
{id:18,cat:'harvest',file:'AGRI-18-HARVEST-JohnDeere-9600-Forage.jpg',brand:'John Deere',name:'9600 Forage Harvester',desc:'Self-Propelled',pi:75},
{id:19,cat:'harvest',file:'AGRI-19-HARVEST-Claas-Jaguar-990.jpg',brand:'Claas',name:'Jaguar 990 Forage',desc:'Forage Cruiser',pi:80},
{id:20,cat:'harvest',file:'AGRI-20-HARVEST-NewHolland-FR650.jpg',brand:'New Holland',name:'FR650 Forage Cruiser',desc:'Forage Harvester',pi:72},
{id:21,cat:'sprayer',file:'AGRI-21-SPRAYER-JohnDeere-612R.jpg',brand:'John Deere',name:'612R Sprayer 36m Boom',desc:'Self-Propelled',pi:45},
{id:22,cat:'sprayer',file:'AGRI-22-SPRAYER-CaseIH-Patriot-4450.jpg',brand:'Case IH',name:'Patriot 4450 Sprayer',desc:'135ft Boom',pi:48},
{id:23,cat:'sprayer',file:'AGRI-23-SPRAYER-NewHolland-Guardian.jpg',brand:'New Holland',name:'Guardian SP.335F Sprayer',desc:'Front Boom',pi:42},
{id:24,cat:'sprayer',file:'AGRI-24-SPRAYER-Kubota-XTA.jpg',brand:'Kubota',name:'XTA Series Sprayer 24m',desc:'Trailed Sprayer',pi:22},
{id:25,cat:'sprayer',file:'AGRI-25-SPRAYER-JohnDeere-412R.jpg',brand:'John Deere',name:'412R Sprayer Precision',desc:'Precision Spray',pi:40},
{id:26,cat:'fert',file:'AGRI-26-FERT-JohnDeere-F4365.jpg',brand:'John Deere',name:'F4365 Dry Spinner Spreader',desc:'Fertilizer',pi:35},
{id:27,cat:'fert',file:'AGRI-27-FERT-CaseIH-Titan-4540.jpg',brand:'Case IH',name:'Titan 4540 Floater',desc:'Floater Fertilizer',pi:38},
{id:28,cat:'fert',file:'AGRI-28-FERT-NewHolland-Speedrower-220.jpg',brand:'New Holland',name:'Speedrower 220',desc:'Fert Applicator',pi:30},
{id:29,cat:'fert',file:'AGRI-29-FERT-Kuhn-Axis-50.jpg',brand:'Kuhn',name:'Axis 50.2 Spreader',desc:'Fert Spreader',pi:18},
{id:30,cat:'fert',file:'AGRI-30-FERT-Amazone-ZA-TS-4200.jpg',brand:'Amazone',name:'ZA-TS 4200 Spreader',desc:'Precision Fert',pi:20},
{id:31,cat:'planter',file:'AGRI-31-PLANTER-JohnDeere-DB120.jpg',brand:'John Deere',name:'DB120 48-Row Planter',desc:'Biggest Planter',pi:55},
{id:32,cat:'planter',file:'AGRI-32-PLANTER-CaseIH-2150.jpg',brand:'Case IH',name:'2150 Early Riser 24-Row',desc:'Early Riser',pi:42},
{id:33,cat:'planter',file:'AGRI-33-PLANTER-Kinze-4705.jpg',brand:'Kinze',name:'4705 36-Row Planter',desc:'36-Row',pi:48},
{id:34,cat:'planter',file:'AGRI-34-PLANTER-NewHolland-PLM.jpg',brand:'New Holland',name:'PLM Planter Precision',desc:'Precision Planter',pi:38},
{id:35,cat:'planter',file:'AGRI-35-PLANTER-JohnDeere-1725C.jpg',brand:'John Deere',name:'1725C Stack-Fold 12-Row',desc:'12-Row Fold',pi:32}
];

function initPi(){ try{ if(window.Pi) Pi.init({version:"2.0", sandbox:isTestnet}); }catch(e){} }

function setMode(test){
 isTestnet=test; initPi();
 document.getElementById('modeBanner').className='mode-banner '+(test?'mode-test':'mode-main');
 document.getElementById('modeBanner').innerText=test?'MODE: TESTNET Pi - Test Payments via approve-payment.js':'MODE: MAINNET Pi - Real Payments Live - Fixed';
 document.getElementById('btnMain').className=test?'':'active';
 document.getElementById('btnTest').className=test?'test-active':'';
}

function filterCat(cat){
 currentCat=cat;
 document.querySelectorAll('.filters button').forEach(b=>b.classList.remove('active'));
 document.getElementById('f-'+cat).classList.add('active');
 render();
}

function render(){
 const g=document.getElementById('grid');
 let list=currentCat==='all'?machines:machines.filter(m=>m.cat===currentCat);
 let html='';
 for(let i=0;i<list.length;i++){
  const m=list[i];
  const badgeClass=m.cat==='plough'?'b-plough':m.cat==='harvest'?'b-harvest':m.cat==='sprayer'?'b-spray':m.cat==='fert'?'b-fert':'b-planter';
  html+='<div class="card" onclick="addToCart('+m.id+')"><span class="badge '+badgeClass+'">'+m.cat.toUpperCase()+'</span><img src="'+m.file+'" onerror="this.src=\'logo-blue.png\'"><div class="card-body"><h3>'+m.brand+'</h3><h3>'+m.name+'</h3><p>'+m.desc+'</p><div class="price">'+m.pi+' Pi</div></div></div>';
 }
 g.innerHTML=html;
}

function addToCart(id){
 const m=machines.find(x=>x.id===id);
 cart.push(m); cartTotal+=m.pi;
 document.getElementById('cart').innerText='🛒 Cart: '+cart.length+' • '+cartTotal.toFixed(1)+' π • Pay with Pi';
}

async function piLogin(){
 const st=document.getElementById('piStatus');
 if(typeof Pi==='undefined'){ st.innerText='Open in Pi Browser App'; return; }
 initPi(); st.innerText='Connecting...';
 try{ const auth=await Pi.authenticate(['username','payments'],()=>{}); piUser=auth.user; st.innerText='✅ @'+auth.user.username+' Connected ('+(isTestnet?'Testnet':'Mainnet')+') Ready'; st.style.background='#d4ffd4'; document.getElementById('loginBtn').innerText='@'+auth.user.username; }catch(e){ st.innerText='Login failed: '+e.message; }
}

async function checkout(){
 const st=document.getElementById('piStatus');
 if(cart.length===0){ st.innerText='Cart empty - tap a machine to add'; return; }
 if(!piUser){ piLogin(); return; }
 initPi();
 const total=cartTotal;
 const memo='AGRI Pi MARKET '+cart.length+' machines '+total+' Pi';
 Pi.createPayment({amount:total, memo:memo, metadata:{cart:cart.map(c=>c.id), total}},{
  onReadyForServerApproval: async function(paymentId){
   st.innerText='Approving '+paymentId+' via /api/approve-payment.js...';
   try{ await fetch('/api/approve-payment',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({paymentId})}); st.innerText='Approved! Confirm in wallet...'; }catch(e){ st.innerText='Approve error: '+e; }
  },
  onReadyForServerCompletion: async function(paymentId, txid){
   st.innerText='Completing TX:'+txid+' via /api/complete-payment.js...';
   try{ await fetch('/api/complete-payment',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({paymentId, txid})}); st.innerText='✅ PAID! '+cart.length+' machines TX:'+txid; alert('Success! Paid '+total+' Pi TX:'+txid); cart=[]; cartTotal=0; document.getElementById('cart').innerText='🛒 Cart: 0 • 0 π • Pay with Pi'; }catch(e){ st.innerText='Paid TX:'+txid; }
  },
  onCancel: function(){ st.innerText='Payment Cancelled'; },
  onError: function(e){ st.innerText='Payment Error:'+e; }
 });
}

initPi(); setMode(false); render
